# =============================================================================
# DevOps/SRE Local Infrastructure - Environment Configuration
# Copy this file to .env and customize values
# =============================================================================

# --- GENERAL ---
COMPOSE_PROJECT_NAME=devops-infra
DATA_ROOT=${HOME}/devops-infra/data
LOGS_ROOT=${HOME}/devops-infra/logs
BACKUP_ROOT=${HOME}/devops-infra/backups
TZ=UTC

# --- POSTGRESQL ---
POSTGRES_PORT=5432
POSTGRES_USER=devops
POSTGRES_PASSWORD=DevOps2024!
POSTGRES_DB=devopsdb
POSTGRES_DATA=${DATA_ROOT}/postgres
POSTGRES_MAX_CONNECTIONS=200

# --- MYSQL ---
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=DevOps2024!Root
MYSQL_USER=devops
MYSQL_PASSWORD=DevOps2024!
MYSQL_DATABASE=devopsdb
MYSQL_DATA=${DATA_ROOT}/mysql

# --- REDIS ---
REDIS_PORT=6379
REDIS_PASSWORD=DevOps2024!Redis
REDIS_DATA=${DATA_ROOT}/redis
REDIS_MAX_MEMORY=512mb

# --- MONGODB ---
MONGO_PORT=27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=DevOps2024!Mongo
MONGO_DATA=${DATA_ROOT}/mongodb

# --- ELASTICSEARCH ---
ES_PORT=9200
ES_TRANSPORT_PORT=9300
ES_DATA=${DATA_ROOT}/elasticsearch
ES_JAVA_OPTS=-Xms512m -Xmx512m
ELASTIC_PASSWORD=DevOps2024!ES

# --- KIBANA ---
KIBANA_PORT=5601
KIBANA_DATA=${DATA_ROOT}/kibana

# --- LOGSTASH ---
LOGSTASH_PORT_BEATS=5044
LOGSTASH_PORT_SYSLOG=5000
LOGSTASH_DATA=${DATA_ROOT}/logstash
LS_JAVA_OPTS=-Xms256m -Xmx256m

# --- PROMETHEUS ---
PROMETHEUS_PORT=9090
PROMETHEUS_DATA=${DATA_ROOT}/prometheus
PROMETHEUS_RETENTION=15d

# --- GRAFANA ---
GRAFANA_PORT=3000
GRAFANA_DATA=${DATA_ROOT}/grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true

# --- ALERTMANAGER ---
ALERTMANAGER_PORT=9093
ALERTMANAGER_DATA=${DATA_ROOT}/alertmanager

# --- NODE EXPORTER ---
NODE_EXPORTER_PORT=9100

# --- CADVISOR ---
CADVISOR_PORT=8088

# --- JENKINS ---
JENKINS_PORT=8081
JENKINS_DATA=${DATA_ROOT}/jenkins
JENKINS_JAVA_OPTS=-Xmx1g

# --- GITLAB ---
GITLAB_HTTP_PORT=8082
GITLAB_SSH_PORT=2222
GITLAB_DATA=${DATA_ROOT}/gitlab
GITLAB_HOSTNAME=gitlab.local

# --- ARGOCD ---
ARGOCD_PORT=8083

# --- SONARQUBE ---
SONARQUBE_PORT=9000
SONARQUBE_DATA=${DATA_ROOT}/sonarqube
SONAR_JDBC_URL=jdbc:postgresql://localhost:5432/sonarqube
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=DevOps2024!Sonar

# --- VAULT ---
VAULT_PORT=8200
VAULT_DATA=${DATA_ROOT}/vault
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token

# --- CONSUL ---
CONSUL_HTTP_PORT=8500
CONSUL_DNS_PORT=8600
CONSUL_DATA=${DATA_ROOT}/consul

# --- RABBITMQ ---
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DATA=${DATA_ROOT}/rabbitmq
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=DevOps2024!RMQ

# --- KAFKA ---
KAFKA_PORT=9092
KAFKA_DATA=${DATA_ROOT}/kafka
ZOOKEEPER_PORT=2181
ZOOKEEPER_DATA=${DATA_ROOT}/zookeeper
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092

# --- NEXUS ---
NEXUS_PORT=8084
NEXUS_DATA=${DATA_ROOT}/nexus

# --- KEYCLOAK ---
KEYCLOAK_PORT=8085
KEYCLOAK_DATA=${DATA_ROOT}/keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=DevOps2024!KC

# --- TRAEFIK ---
TRAEFIK_HTTP_PORT=8086
TRAEFIK_DASHBOARD_PORT=8090
TRAEFIK_DATA=${DATA_ROOT}/traefik

# --- MINIO ---
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
MINIO_DATA=${DATA_ROOT}/minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=DevOps2024!Minio

# --- DOCKER REGISTRY ---
REGISTRY_PORT=5000
REGISTRY_DATA=${DATA_ROOT}/registry

# --- NGINX ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- APACHE ---
APACHE_PORT=8080

# --- KUBERNETES ---
K3S_PORT=6443
KUBECONFIG=${HOME}/.kube/config

# --- MONITORING EXPORTERS ---
PG_EXPORTER_PORT=9187
MYSQL_EXPORTER_PORT=9104
REDIS_EXPORTER_PORT=9121
MONGO_EXPORTER_PORT=9216
ES_EXPORTER_PORT=9114
KAFKA_EXPORTER_PORT=9308
NGINX_EXPORTER_PORT=9113
RABBITMQ_EXPORTER_PORT=15692

# --- BACKUP ---
BACKUP_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=12
BACKUP_SCHEDULE="0 2 * * *"
HEALTHCHECK_SCHEDULE="*/5 * * * *"
